# Sales CRM — config/.env (written by the kernel's installer at apply; design §14). Never commit the real file.
APP_ENV=prod
APP_DEBUG=0
APP_NAME="Sales CRM"
APP_KEY=sales_crm
APP_URL=https://crm.example.com
# the record database (the installer creates it and the three roles)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subello_sales_crm
DB_USER=sales_crm_rw
DB_PASSWORD=
MCP_RECORDS_DB_USER=sales_crm_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=sales_crm_activity_ro
MCP_ACTIVITY_DB_PASSWORD=
# the ports (pinned before the first apply: deploy/ROOT_STEPS.sh step 0)
APP_INTERNAL_PORT=8191
MCP_RECORDS_PORT=8843
MCP_ACTIVITY_PORT=8844
# the kernel's (copied by the installer)
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=
OS_APPLICATION_TOKEN=
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/
# the tenant's one memory (activity episodes)
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=
# mail (optional; the installer fills them from ~/.malumail or the kernel's)
MALUMAIL_API_URL=https://api.malumail.com
MALUMAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# the logging mailbox's webhook secret (ROOT_STEPS.sh step 3; the row in `mailboxes` names this key in webhook_secret_ref)
MAILBOX_CRM_WEBHOOK_SECRET=
# attachments, import files and exports: default storage/ under the install; a mount the owner names
CRM_STORAGE_DIR=
# may only LOWER crm_settings.import_max_rows
CRM_MAX_IMPORT_ROWS=
# CORS origins for the token API, comma-separated (none by default)
API_CORS_ORIGINS=
