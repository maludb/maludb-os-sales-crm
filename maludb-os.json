{
  "schema": "maludb-os.application/1",
  "catalog_key": "sales_crm",
  "name": "Sales CRM",
  "description": "Prospecting and customer relationship management: leads worked and converted into accounts, contacts and deals; every company and person with one timeline of calls, emails, meetings and notes; deals moved through pipelines on a kanban board that shows the sales cycle, with the next step on every card; a reminder calendar of the work to do; email logged by a BCC address and sent with templates; campaigns, lists, imports and the forecast, funnel and activity reports a sales manager runs a team by. The Sales CRM Expert works the command bar; the Sales Assistant writes each seller's weekday morning note and proposes the next step on every deal that lacks one.",
  "business_area": "Sales & Service",
  "category": "crm",
  "icon": "feather-target",
  "version": "0.1.0",
  "criticality": "medium",
  "vhost": {
    "label": "crm",
    "document_root": "html",
    "internal_port_env": "APP_INTERNAL_PORT"
  },
  "database": {
    "suffix": "sales_crm",
    "migrations": "db",
    "roles": {
      "rw": "sales_crm_rw",
      "records_ro": "sales_crm_records_ro",
      "activity_ro": "sales_crm_activity_ro"
    }
  },
  "env": {
    "required": [
      "APP_NAME",
      "APP_URL",
      "DB_HOST",
      "DB_PORT",
      "DB_NAME",
      "DB_USER",
      "DB_PASSWORD",
      "MCP_RECORDS_DB_USER",
      "MCP_RECORDS_DB_PASSWORD",
      "MCP_ACTIVITY_DB_USER",
      "MCP_ACTIVITY_DB_PASSWORD",
      "APP_INTERNAL_PORT",
      "MCP_RECORDS_PORT",
      "MCP_ACTIVITY_PORT",
      "ACTION_TOKEN_KEY",
      "ACTIONS_RELAY_KEY",
      "OS_APPLICATION_TOKEN",
      "OS_INTERNAL_URL",
      "OS_LAUNCHER_URL",
      "APP_KEY",
      "MALUDB_API_URL",
      "MALUDB_API_TOKEN"
    ],
    "optional": [
      "MALUMAIL_API_KEY",
      "MAIL_FROM",
      "MAIL_FROM_NAME",
      "MAILBOX_CRM_WEBHOOK_SECRET",
      "CRM_STORAGE_DIR",
      "CRM_MAX_IMPORT_ROWS"
    ]
  },
  "services": [
    "deploy/sales_crm-records-mcp.service",
    "deploy/sales_crm-activity-mcp.service",
    "deploy/sales_crm-activity-ingest.service",
    "deploy/sales_crm-activity-ingest.timer",
    "deploy/sales_crm-directory-sync.service",
    "deploy/sales_crm-directory-sync.timer",
    "deploy/sales_crm-worker.service",
    "deploy/sales_crm-worker.timer"
  ],
  "endpoints": [
    {
      "name": "Web UI",
      "kind": "ui",
      "path": "/",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Health",
      "kind": "http_api",
      "path": "/api/v1/health",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Calendar feed (ICS)",
      "kind": "http_api",
      "path": "/api/v1/calendar.ics",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Mailbox webhook",
      "kind": "http_api",
      "path": "/channels/malumail/mail",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Records API",
      "kind": "http_api",
      "path": "/api/v1/",
      "auth_kind": "bearer",
      "agent_reachable": false
    },
    {
      "name": "Records MCP",
      "kind": "mcp",
      "path": "/mcp/records",
      "auth_kind": "bearer",
      "agent_reachable": true,
      "mcp_surface_version": 1
    },
    {
      "name": "Activity MCP",
      "kind": "mcp",
      "path": "/mcp/activity",
      "auth_kind": "bearer",
      "agent_reachable": true,
      "mcp_surface_version": 1
    }
  ],
  "actions": {
    "manifest": "docs/sales-crm-action-manifest.md",
    "registry": "mcp/action_registry.json",
    "base_url_env": "APP_INTERNAL_PORT"
  },
  "skills": [
    "skills/sales-crm-basics",
    "skills/activity-based-selling",
    "skills/qualifying-a-lead",
    "skills/reading-the-pipeline",
    "skills/morning-note",
    "skills/propose-the-next-step",
    "skills/log-a-call-from-dictation",
    "skills/convert-a-lead-into-a-deal",
    "skills/find-and-merge-duplicates"
  ],
  "sso": {
    "path": "/sso",
    "logout_path": "/sso/logout"
  },
  "directory": {
    "reads": true,
    "writes": false
  },
  "assistant": {
    "command_bar": true,
    "agent": "expert"
  },
  "roles": [
    {
      "key": "viewer",
      "name": "Viewer",
      "description": "Reads everything — every record with amounts, every report, every calendar — and changes nothing. Finance, support, leadership.",
      "capability": "read",
      "is_admin": false,
      "rights": [
        "records.read",
        "calendar.read"
      ]
    },
    {
      "key": "user",
      "name": "Sales Rep",
      "description": "A seller: their leads, accounts, contacts and deals and everyone else's (open by default); logs activities, moves their deals, sends logged email, runs their calendar, imports into their own lists.",
      "capability": "write",
      "is_admin": false,
      "rights": [
        "records.read",
        "calendar.read",
        "leads.write",
        "leads.convert",
        "accounts.write",
        "contacts.write",
        "deals.write",
        "activities.write",
        "email.log",
        "email.send",
        "tags.apply",
        "lists.own",
        "imports.own",
        "export.own",
        "calendar.own"
      ]
    },
    {
      "key": "marketing",
      "name": "Marketing",
      "description": "Leads, sources, campaigns, lists, segments, imports and the shared templates; deals and activities read-only.",
      "capability": "write",
      "is_admin": false,
      "rights": [
        "records.read",
        "calendar.read",
        "leads.write",
        "leads.assign",
        "sources.manage",
        "campaigns.manage",
        "lists.own",
        "lists.shared",
        "imports.own",
        "imports.shared",
        "templates.manage",
        "tags.apply",
        "tags.manage",
        "export.own",
        "export.shared",
        "calendar.own"
      ]
    },
    {
      "key": "manager",
      "name": "Sales Manager",
      "description": "Runs a team: anyone's deals and activities, reassigns, reopens, merges, bulk-edits, restricts; owns pipelines, stages, rules, quotas and lost reasons; every report; the team calendar.",
      "capability": "write",
      "is_admin": false,
      "rights": [
        "records.read",
        "calendar.read",
        "leads.write",
        "leads.convert",
        "leads.assign",
        "accounts.write",
        "contacts.write",
        "deals.write",
        "deals.any",
        "activities.write",
        "activities.any",
        "email.log",
        "email.send",
        "templates.manage",
        "tags.apply",
        "tags.manage",
        "lists.own",
        "lists.shared",
        "campaigns.manage",
        "sources.manage",
        "imports.own",
        "imports.shared",
        "export.own",
        "export.shared",
        "records.restrict",
        "records.merge",
        "records.bulk",
        "pipelines.manage",
        "assignment.rules",
        "reports.team",
        "calendar.own",
        "calendar.team",
        "quotas.manage"
      ]
    },
    {
      "key": "admin",
      "name": "CRM admin",
      "description": "Every right: settings, custom fields, the logging mailbox, the agents' settings, keys and the API, purge, costs. A super-admin holds this role.",
      "capability": "admin",
      "is_admin": true,
      "rights": [
        "*"
      ]
    }
  ],
  "shares": [
    {
      "tool": "accounts_index",
      "description": "Every account the business keeps: id, name, domain, kind, owner, the ledger's id when known, the open and won totals — paged, with `since` (os.sales-crm-accounts/1)",
      "scoped": false
    },
    {
      "tool": "contacts_index",
      "description": "Contacts by account: id, name, every address, title, role, opt-outs, account id — paged, with `since`; the Help Desk's requester match (os.sales-crm-contacts/1)",
      "scoped": false
    },
    {
      "tool": "deals_won",
      "description": "Deals won in a period: number, title, account (id, name, the ledger's id), the primary contact, value, currency, products (name, provider id, quantity, unit price, discount), won date, owner — for the General Ledger's customer and invoice, Inventory's order, Consultant Tracking's engagement (os.sales-crm-deals-won/1)",
      "scoped": false
    },
    {
      "tool": "deals_open_by_account",
      "description": "One account's open deals: number, title, stage, value, weighted, expected close, owner, the next step's date — for a Help Desk ticket or a Spaces card; no bodies, no notes (os.sales-crm-deals-open/1)",
      "scoped": false
    },
    {
      "tool": "account_timeline_summary",
      "description": "One account's last ten touches (date, kind, subject, who) and its next step — dates and subjects only, never a body or a note (os.sales-crm-timeline/1)",
      "scoped": false
    }
  ],
  "reads": [
    {
      "app": "gl",
      "tool": "customer_by_crm_account",
      "why": "Show the ledger's customer id and balance on the account once a won deal made the customer (G3 — owed by General Ledger); degrades to a blank panel on no_connection"
    },
    {
      "app": "gl",
      "tool": "items_index",
      "why": "The product picker on a deal's lines names the ledger's items (G4 — owed by General Ledger); typed names otherwise"
    },
    {
      "app": "inventory",
      "tool": "availability_index",
      "why": "The product picker on a deal's lines names Inventory's variants with our retail (built); typed names otherwise"
    },
    {
      "app": "helpdesk",
      "tool": "tickets_by_organization",
      "why": "The account's Tickets tab (HD5 — owed by Help Desk); an empty panel on no_connection"
    }
  ],
